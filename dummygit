#!/usr/bin/env bash
# dummygit - switch GitHub profiles without the pain.
# Configure each profile once. After that, activating one is a click.
#
# Two separate things get switched, and they are kept separate on purpose:
#   1. Commit identity  - the name/email stamped on your commits (git config user.*)
#   2. Authentication   - how GitHub verifies you on push (gh CLI account or SSH key)
# Switching only the first is cosmetic: your commits say "work" but you still
# push as "personal". dummygit switches both, and warns about the config that
# can silently defeat a switch (stored credential helpers, ssh config host
# blocks, repo-local overrides).

set -euo pipefail

VERSION="0.3.0"
DG_DIR="${DUMMYGIT_DIR:-$HOME/.dummygit}"
PROFILES_DIR="$DG_DIR/profiles"
ACTIVE_FILE="$DG_DIR/active"
SSH_MARKER="$DG_DIR/ssh-command"

die() { printf 'dummygit: %s\n' "$*" >&2; exit 1; }
warn() { printf 'warning: %s\n' "$*" >&2; }
need_git() { command -v git >/dev/null 2>&1 || die "git is not installed."; }

profile_path() {
  case "${1:-}" in
    ""|*[!a-z0-9-]*) die "profile names use lowercase letters, numbers and dashes only: '${1:-}'" ;;
  esac
  printf '%s/%s.conf' "$PROFILES_DIR" "$1"
}

load_profile() {
  local file
  file="$(profile_path "$1")"
  [ -f "$file" ] || die "no profile called '$1'. Create it: dummygit add $1"
  GIT_NAME=""; GIT_EMAIL=""; GH_USER=""; SSH_KEY=""
  # shellcheck disable=SC1090
  . "$file"
  [ -n "$GIT_NAME" ] && [ -n "$GIT_EMAIL" ] || die "profile '$1' is missing GIT_NAME or GIT_EMAIL. Edit: $file"
}

list_profiles() {
  local f
  for f in "$PROFILES_DIR"/*.conf; do
    [ -e "$f" ] || continue
    basename "$f" .conf
  done
}

# ---------------------------------------------------------------- guards
# Things that can silently defeat a switch. Warnings only; dummygit does not
# rewrite config it does not own.

check_credential_helpers() {
  # If any credential.helper for github.com is not gh's own, stored credentials
  # for the OTHER account may still be served on https pushes even after
  # gh auth switch.
  local h
  h="$(git config --global --get-all credential.helper 2>/dev/null || true)"
  local hh
  hh="$(git config --global --get-all credential.https://github.com.helper 2>/dev/null || true)"
  case "$hh" in
    *"gh auth git-credential"*) return 0 ;;  # gh owns the host helper, good
  esac
  if [ -n "$h" ] && ! printf '%s\n' "$h" | grep -q 'gh auth git-credential'; then
    warn "git credential.helper is '$h', not GitHub CLI."
    warn "  Stored https credentials would still push as the old account even"
    warn "  after gh auth switch. Fix once:"
    warn "    gh auth setup-git"
    warn "    then remove stale github.com entries from '$h'."
    return 1
  fi
  return 0
}

check_ssh_config() {
  # A Host github.com block in ~/.ssh/config with its own IdentityFile competes
  # with our -i key. Command-line -i is tried first, but both can be offered.
  local cfg="$HOME/.ssh/config"
  [ -f "$cfg" ] || return 0
  if awk '/^[Hh]ost /{inblk=0; for(i=2;i<=NF;i++) if($i=="github.com") inblk=1; next} inblk && /^[[:space:]]*[Ii]dentity[Ff]ile/{found=1} END{exit !found}' "$cfg" 2>/dev/null; then
    warn "~/.ssh/config has an IdentityFile for Host github.com."
    warn "  It competes with dummygit's key switching and can silently auth as"
    warn "  the wrong account. Fix: remove that IdentityFile line and let each"
    warn "  dummygit profile carry its own key."
    return 1
  fi
  return 0
}

check_repo_overrides() {
  # Only relevant when run inside a repo: local config wins over the global we set.
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0
  local le ln ls
  le="$(git config --local --get user.email 2>/dev/null || true)"
  ln="$(git config --local --get user.name 2>/dev/null || true)"
  ls="$(git config --local --get core.sshCommand 2>/dev/null || true)"
  local conflict=0
  if [ -n "$le" ] || [ -n "$ln" ] || [ -n "$ls" ]; then
    conflict=1
    warn "this repo has its OWN local git config - the global switch does NOT"
    warn "  apply here:"
    [ -n "$ln" ] && warn "    local user.name = $ln"
    [ -n "$le" ] && warn "    local user.email = $le"
    [ -n "$ls" ] && warn "    local core.sshCommand = $ls"
    warn "  Clear with: git config --local --unset user.email   (etc.)"
  fi
  local url
  url="$(git config --local --get remote.origin.url 2>/dev/null || true)"
  case "$url" in
    https://*@*) conflict=1; warn "remote URL embeds credentials; it ignores profile switching: $url" ;;
  esac
  return $conflict
}

# Pre-flight: conflicts that would defeat the switch block activation entirely.
preflight() {
  local gh_user="${1:-}" ssh_key="${2:-}" blocked=0
  if [ -n "$gh_user" ]; then
    check_credential_helpers || blocked=1
  fi
  if [ -n "$ssh_key" ]; then
    check_ssh_config || blocked=1
  fi
  return $blocked
}

run_all_guards() {
  local conflicts=0
  check_credential_helpers || conflicts=$((conflicts + 1))
  check_ssh_config || conflicts=$((conflicts + 1))
  check_repo_overrides || conflicts=$((conflicts + 1))
  return $conflicts
}

# Snapshot what activation is about to change, for `dummygit undo`.
# Scope note: this covers git config only. gh-side state (gh auth switch,
# gh auth setup-git) is gh's own and is not snapshotted.
snapshot_state() {
  mkdir -p "$DG_DIR"
  local name email sshcmd active
  name="$(git config --global --get user.name 2>/dev/null || printf '%s' '__UNSET__')"
  email="$(git config --global --get user.email 2>/dev/null || printf '%s' '__UNSET__')"
  sshcmd="$(git config --global --get core.sshCommand 2>/dev/null || printf '%s' '__UNSET__')"
  active=""
  [ -f "$ACTIVE_FILE" ] && active="$(cat "$ACTIVE_FILE")"
  {
    printf 'PREV_NAME=%q\n' "$name"
    printf 'PREV_EMAIL=%q\n' "$email"
    printf 'PREV_SSHCMD=%q\n' "$sshcmd"
    printf 'PREV_ACTIVE=%q\n' "$active"
  } > "$DG_DIR/previous.conf"
}

# ---------------------------------------------------------------- commands

cmd_add() {
  local name="${1:-}"
  if [ -z "$name" ]; then
    printf 'Profile name (e.g. personal, work): '
    read -r name
  fi
  local file
  file="$(profile_path "$name")"
  [ -e "$file" ] && die "profile '$name' already exists. Remove it first: dummygit remove $name"
  mkdir -p "$PROFILES_DIR"

  printf 'Setting up profile "%s" (one time only).\n' "$name"
  printf 'Git author name (shown on commits): '
  read -r GIT_NAME
  printf 'Git email for this account (GitHub matches commits by email): '
  read -r GIT_EMAIL
  [ -n "$GIT_NAME" ] && [ -n "$GIT_EMAIL" ] || die "name and email are required."

  GH_USER=""; SSH_KEY=""
  printf '\nHow should this profile authenticate to GitHub on push?\n'
  printf '  1) GitHub CLI account (gh) - best for https remotes\n'
  printf '  2) A dedicated SSH key     - best for git@github.com remotes\n'
  printf '  3) Skip for now            - only commit identity will switch\n'
  printf 'Pick [1/2/3]: '
  read -r auth
  case "$auth" in
    1)
      command -v gh >/dev/null 2>&1 || die "GitHub CLI (gh) is not installed. Install it from cli.github.com, or pick 2."
      printf 'GitHub username for this profile: '
      read -r GH_USER
      [ -n "$GH_USER" ] || die "username is required for gh switching."
      ;;
    2)
      local default_key="$HOME/.ssh/id_ed25519_$name"
      printf 'SSH private key path [%s]: ' "$default_key"
      read -r SSH_KEY
      SSH_KEY="${SSH_KEY:-$default_key}"
      SSH_KEY="${SSH_KEY/#\~/$HOME}"
      if [ ! -f "$SSH_KEY" ]; then
        printf 'No key at %s. Generate one now? [Y/n] ' "$SSH_KEY"
        read -r gen
        case "$gen" in
          n|N) die "key not found; profile not saved." ;;
          *)
            mkdir -p "$HOME/.ssh"
            ssh-keygen -t ed25519 -C "$GIT_EMAIL" -f "$SSH_KEY" -N "" >/dev/null || die "ssh-keygen failed."
            printf '\nNew key created. Add this PUBLIC key to the "%s" GitHub account\n' "$name"
            printf '(github.com -> Settings -> SSH and GPG keys -> New SSH key):\n\n'
            cat "$SSH_KEY.pub"
            printf '\n\n'
            ;;
        esac
      fi
      ;;
    3) ;;
    *) die "pick 1, 2 or 3." ;;
  esac

  {
    printf 'GIT_NAME=%q\n' "$GIT_NAME"
    printf 'GIT_EMAIL=%q\n' "$GIT_EMAIL"
    printf 'GH_USER=%q\n' "$GH_USER"
    printf 'SSH_KEY=%q\n' "$SSH_KEY"
  } > "$file"
  printf '\nProfile "%s" saved.\n' "$name"

  printf 'Activate it now? [Y/n] '
  read -r now
  case "$now" in
    n|N) printf 'Later: dummygit use %s\n' "$name" ;;
    *) cmd_use "$name" ;;
  esac
}

cmd_use() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: dummygit use <profile>"
  need_git
  load_profile "$name"

  # Pre-flight: if existing config would defeat this switch, change nothing.
  if ! preflight "$GH_USER" "$SSH_KEY"; then
    die "activation BLOCKED. Fix the conflicts above, then run: dummygit use $name
Nothing was changed. Profile '$name' is NOT active."
  fi

  # Remember what we are about to change, for `dummygit undo`.
  snapshot_state

  # 1. Commit identity
  git config --global user.name "$GIT_NAME"
  git config --global user.email "$GIT_EMAIL"

  # 2. Authentication (separate from identity, on purpose)
  if [ -n "$SSH_KEY" ]; then
    [ -f "$SSH_KEY" ] || die "profile '$name' expects SSH key $SSH_KEY but it does not exist."
    local sshcmd="ssh -i $SSH_KEY -o IdentitiesOnly=yes"
    git config --global core.sshCommand "$sshcmd"
    printf '%s\n' "$sshcmd" > "$SSH_MARKER"
  else
    # Remove core.sshCommand only if dummygit itself set it; never clobber a
    # value the user configured by hand.
    if [ -f "$SSH_MARKER" ]; then
      local cur
      cur="$(git config --global --get core.sshCommand 2>/dev/null || true)"
      if [ "$cur" = "$(cat "$SSH_MARKER")" ]; then
        git config --global --unset core.sshCommand
      fi
      rm -f "$SSH_MARKER"
    fi
  fi

  if [ -n "$GH_USER" ]; then
    if command -v gh >/dev/null 2>&1; then
      local out
      if out="$(gh auth switch --user "$GH_USER" 2>&1)"; then
        # NOTE: this WRITES global git config (host-scoped credential helper
        # for github.com). Without it, git-over-https keeps using whatever
        # credentials were stored before, so the switch would be cosmetic.
        gh auth setup-git >/dev/null 2>&1 || true
      else
        warn "gh could not switch to \"$GH_USER\". Log in once with: gh auth login"
      fi
    else
      warn "gh is not installed; authentication left unchanged."
    fi
  fi

  printf '%s\n' "$name" > "$ACTIVE_FILE"
  printf 'Active profile: %s\n' "$name"
  printf '  commits as: %s <%s>\n' "$GIT_NAME" "$GIT_EMAIL"
  if [ -n "$SSH_KEY" ]; then
    printf '  pushes via: SSH key %s\n' "$SSH_KEY"
  elif [ -n "$GH_USER" ]; then
    printf '  pushes via: gh account %s\n' "$GH_USER"
  else
    printf '  pushes via: unchanged (no auth method configured for this profile)\n'
  fi
  printf '  (reverse the git config part with: dummygit undo)\n'

  # Repo-local config beats the global switch. Say so loudly, and exit nonzero
  # so scripts see the activation did not fully take.
  if ! check_repo_overrides; then
    printf '\nNOT ACTIVE IN THIS REPO (%s): local overrides above win here.\n' "$(git rev-parse --show-toplevel 2>/dev/null)" >&2
    printf 'Global profile "%s" is active everywhere else.\n' "$name" >&2
    return 2
  fi
}

cmd_undo() {
  need_git
  local f="$DG_DIR/previous.conf"
  [ -f "$f" ] || die "nothing to undo (no previous state recorded)."
  PREV_NAME=""; PREV_EMAIL=""; PREV_SSHCMD=""; PREV_ACTIVE=""
  # shellcheck disable=SC1090
  . "$f"

  restore_key() {
    # $1 = git config key, $2 = saved value or __UNSET__
    if [ "$2" = "__UNSET__" ]; then
      case "$1" in
        core.sshCommand)
          # unset only if the current value is one dummygit set
          if [ -f "$SSH_MARKER" ] && [ "$(git config --global --get core.sshCommand 2>/dev/null || true)" = "$(cat "$SSH_MARKER")" ]; then
            git config --global --unset core.sshCommand
          fi
          rm -f "$SSH_MARKER"
          ;;
        *)
          git config --global --unset "$1" 2>/dev/null || true
          ;;
      esac
    else
      git config --global "$1" "$2"
      if [ "$1" = "core.sshCommand" ]; then rm -f "$SSH_MARKER"; fi
    fi
  }

  restore_key user.name "$PREV_NAME"
  restore_key user.email "$PREV_EMAIL"
  restore_key core.sshCommand "$PREV_SSHCMD"

  if [ -n "$PREV_ACTIVE" ]; then
    printf '%s\n' "$PREV_ACTIVE" > "$ACTIVE_FILE"
  else
    rm -f "$ACTIVE_FILE"
  fi
  rm -f "$f"
  printf 'Undone. Restored git identity: %s <%s>\n' "$PREV_NAME" "$PREV_EMAIL"
  printf 'Note: gh-side state (gh auth switch / setup-git) is not reversed by undo;\n'
  printf 'use gh auth switch --user <other> to flip gh back.\n'
}

cmd_list() {
  local active=""
  [ -f "$ACTIVE_FILE" ] && active="$(cat "$ACTIVE_FILE")"
  local found=0 p mark
  for p in $(list_profiles); do
    found=1
    mark=" "
    [ "$p" = "$active" ] && mark="*"
    GIT_NAME=""; GIT_EMAIL=""; GH_USER=""; SSH_KEY=""
    # shellcheck disable=SC1090
    . "$(profile_path "$p")"
    printf '%s %-12s %s <%s>\n' "$mark" "$p" "$GIT_NAME" "$GIT_EMAIL"
  done
  [ "$found" -eq 1 ] || printf 'No profiles yet. Add one: dummygit add personal\n'
}

cmd_status() {
  need_git
  local active="(none)"
  [ -f "$ACTIVE_FILE" ] && active="$(cat "$ACTIVE_FILE")"
  printf 'dummygit active profile: %s\n' "$active"
  printf 'git identity:  %s <%s>\n' "$(git config --global --get user.name || true)" "$(git config --global --get user.email || true)"
  local sshcmd
  sshcmd="$(git config --global --get core.sshCommand 2>/dev/null || true)"
  if [ -n "$sshcmd" ]; then
    printf 'ssh auth:      %s\n' "$sshcmd"
  else
    printf 'ssh auth:      (default ssh behavior)\n'
  fi
  if command -v gh >/dev/null 2>&1; then
    printf 'gh accounts:\n'
    gh auth status 2>&1 | sed 's/^/  /' || true
  else
    printf 'gh accounts:   (gh not installed)\n'
  fi
}

cmd_doctor() {
  need_git
  printf 'dummygit doctor - checking for config that can defeat switching\n\n'
  if run_all_guards; then
    printf '\nNo conflicts found.\n'
  else
    printf '\nConflicts found (see above). These block or weaken activation.\n'
    return 1
  fi
}

cmd_remove() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: dummygit remove <profile>"
  local file
  file="$(profile_path "$name")"
  [ -f "$file" ] || die "no profile called '$name'."
  rm -f "$file"
  if [ -f "$ACTIVE_FILE" ] && [ "$(cat "$ACTIVE_FILE")" = "$name" ]; then
    rm -f "$ACTIVE_FILE"
  fi
  printf 'Removed profile "%s". Your current git config was left as-is.\n' "$name"
}

# ---------------------------------------------------------------- pickers

pick_terminal() {
  local profiles=()
  local p
  for p in $(list_profiles); do profiles+=("$p"); done
  [ "${#profiles[@]}" -gt 0 ] || die "no profiles yet. Add one: dummygit add personal"
  local active=""
  [ -f "$ACTIVE_FILE" ] && active="$(cat "$ACTIVE_FILE")"
  printf 'Which profile?\n'
  local i mark
  for i in "${!profiles[@]}"; do
    mark=" "
    [ "${profiles[$i]}" = "$active" ] && mark="*"
    printf '  %d) %s %s\n' "$((i + 1))" "$mark" "${profiles[$i]}"
  done
  printf 'Pick a number: '
  local pick
  read -r pick
  case "$pick" in
    ''|*[!0-9]*) die "not a number." ;;
  esac
  [ "$pick" -ge 1 ] && [ "$pick" -le "${#profiles[@]}" ] || die "out of range."
  cmd_use "${profiles[$((pick - 1))]}"
}

# GUI picker: one click on a profile button activates it.
# macOS: osascript. Linux: zenity or kdialog. Windows (Git Bash): PowerShell.
pick_gui() {
  local profiles=()
  local p
  for p in $(list_profiles); do profiles+=("$p"); done
  [ "${#profiles[@]}" -gt 0 ] || die "no profiles yet. Add one: dummygit add personal"
  local chosen=""

  if command -v osascript >/dev/null 2>&1; then
    local list=""
    for p in "${profiles[@]}"; do list="$list\"$p\", "; done
    list="${list%, }"
    chosen="$(osascript -e "choose from list {$list} with title \"Dummy Git\" with prompt \"Activate which GitHub profile?\"" 2>/dev/null || true)"
    [ "$chosen" = "false" ] && chosen=""
  elif { command -v zenity >/dev/null 2>&1 || command -v kdialog >/dev/null 2>&1; } && [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
    # Dialog tools exist but there is no display to draw them on (SSH,
    # headless shell). Not a usable GUI: let the caller fall back.
    return 1
  elif command -v zenity >/dev/null 2>&1; then
    chosen="$(zenity --list --title='Dummy Git' --text='Activate which GitHub profile?' \
      --column='Profile' "${profiles[@]}" 2>/dev/null || true)"
  elif command -v kdialog >/dev/null 2>&1; then
    local args=()
    for p in "${profiles[@]}"; do args+=("$p" "$p" off); done
    chosen="$(kdialog --title 'Dummy Git' --radiolist 'Activate which GitHub profile?' "${args[@]}" 2>/dev/null || true)"
  elif command -v powershell.exe >/dev/null 2>&1; then
    local pslist=""
    for p in "${profiles[@]}"; do pslist="$pslist'$p',"; done
    pslist="${pslist%,}"
    chosen="$(powershell.exe -NoProfile -Command "Add-Type -AssemblyName System.Windows.Forms; \$f=New-Object System.Windows.Forms.Form; \$f.Text='Dummy Git'; \$f.Width=320; \$f.Height=160; \$f.StartPosition='CenterScreen'; \$b=New-Object System.Windows.Forms.FlowLayoutPanel; \$b.Dock='Fill'; \$b.FlowDirection='TopDown'; @($pslist) | ForEach-Object { \$btn=New-Object System.Windows.Forms.Button; \$btn.Text=\$_; \$btn.Width=260; \$btn.Tag=\$_; \$btn.Add_Click({ \$f.Tag=\$this.Tag; \$f.Close() }); \$b.Controls.Add(\$btn) }; \$f.Controls.Add(\$b); \$f.ShowDialog() | Out-Null; Write-Output \$f.Tag" 2>/dev/null | tr -d '\r' || true)"
  else
    return 1
  fi

  if [ -z "$chosen" ]; then
    printf 'Cancelled.\n'
    return 0
  fi
  cmd_use "$chosen"
}

cmd_help() {
  cat <<'EOF'
dummygit - dead-simple GitHub profile switching.

One-time setup per profile:
  dummygit add personal
  dummygit add work

Every time after that (this is the whole point):
  dummygit              click a profile button (falls back to a number
                        picker when no GUI dialog tool is available)
  dummygit use work     or name it directly, no prompt

Other commands:
  dummygit list         show profiles (* = active)
  dummygit status       show current identity + authentication
  dummygit doctor       check for config that can defeat a switch
  dummygit undo         restore the git config from before the last activation
  dummygit remove work  delete a profile
  dummygit help         this text

What "activate" changes:
  1. Commit identity  - global git config user.name / user.email
  2. Authentication   - gh CLI account (gh auth switch) AND global git
                        credential config (gh auth setup-git), or a dedicated
                        SSH key (global core.sshCommand)
  Activation BLOCKS (nothing changed) if existing config would defeat the
  switch: a non-gh credential.helper, or an IdentityFile for github.com in
  ~/.ssh/config. A repo with local overrides activates globally but reports
  NOT ACTIVE IN THIS REPO and exits nonzero.
EOF
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    "")
      # Bare `dummygit` is the button: GUI picker when possible, else terminal.
      pick_gui || pick_terminal ;;
    pick)      pick_terminal ;;
    gui)       pick_gui || die "no GUI dialog tool found (need osascript, zenity, kdialog or powershell.exe). Use: dummygit pick" ;;
    add)       shift; cmd_add "$@" ;;
    use)       shift; cmd_use "$@" ;;
    list|ls)   cmd_list ;;
    status)    cmd_status ;;
    doctor)    cmd_doctor ;;
    undo)      cmd_undo ;;
    remove|rm) shift; cmd_remove "$@" ;;
    help|-h|--help) cmd_help ;;
    version|--version) printf 'dummygit %s\n' "$VERSION" ;;
    *) die "unknown command: $cmd (try: dummygit help)" ;;
  esac
}

main "$@"
